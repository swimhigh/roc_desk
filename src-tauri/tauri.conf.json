{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "roc_desk",
  "identifier": "com.rocdesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix src-web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix src-web",
    "frontendDist": "../src-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "roc_desk",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
